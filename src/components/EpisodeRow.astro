---
import Cover from "./Cover.astro";
import Shift from "./Shift.astro";
import { episodeUrl, formatDate, minutes, type Episode } from "../lib/episodes";
interface Props {
  episode: Episode;
}
const { episode } = Astro.props;
const d = episode.data;
---

<li class="row" data-search={`${d.title} ${d.guest.name} ${d.guest.role} ${d.guest.place}`.toLowerCase()}>
  <a href={episodeUrl(episode)}>
    <Cover scene={d.cover} number={d.number} label="" class="thumb" />
    <span class="num mono">{d.number}</span>
    <span class="text">
      <span class="title">{d.title}</span>
      <span class="guest">{d.guest.name}, {d.guest.role.toLowerCase()}</span>
    </span>
    <span class="meta mono">
      <span>{formatDate(d.date, "short")}</span>
      <span>{minutes(d.duration)}</span>
    </span>
    <Shift time={d.shift} />
  </a>
</li>

<style>
  .row + .row {
    border-top: 1px solid var(--line);
  }
  a {
    display: grid;
    grid-template-columns: 64px 24px 1fr auto 72px;
    align-items: center;
    gap: 20px;
    padding: 16px 12px;
    margin: 0 -12px;
    border-radius: 12px;
    text-decoration: none;
    transition: background-color 150ms var(--ease);
  }
  a:hover {
    background: var(--card);
  }
  .row :global(.thumb) {
    width: 64px;
    height: 64px;
    border-radius: 8px;
  }
  .num {
    color: var(--muted);
    font-size: 13px;
  }
  .text {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .title {
    font-size: 18px;
    font-weight: 500;
  }
  .guest {
    color: var(--text-2);
    font-size: 15px;
  }
  .meta {
    display: flex;
    gap: 20px;
    color: var(--muted);
    font-size: 13px;
  }
  .meta span:last-child {
    width: 52px;
    text-align: right;
  }
  .row :global(.shift) {
    justify-self: end;
  }
  @media (max-width: 760px) {
    a {
      grid-template-columns: 56px 1fr auto;
      gap: 4px 16px;
    }
    .row :global(.thumb) {
      width: 56px;
      height: 56px;
      grid-row: span 2;
    }
    .num {
      display: none;
    }
    .meta {
      grid-column: 2;
      gap: 12px;
    }
    .meta span:last-child {
      width: auto;
      text-align: left;
    }
    .text {
      grid-column: 2 / -1;
    }
    .row :global(.shift) {
      grid-column: 3;
      grid-row: 2;
    }
  }
</style>
