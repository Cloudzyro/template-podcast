---
import { show } from "../data/show";
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="wrap bar">
    <Logo />
    <nav aria-label="Main">
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="menu">
        <Icon name="menu" class="i-open" />
        <Icon name="close" class="i-close" />
        <span class="sr">Menu</span>
      </button>
      <ul id="menu">
        {
          show.nav.map((item) => (
            <li>
              <a href={item.href} aria-current={path === item.href ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="cta">
          <a class="btn btn-quiet btn-small" href="/#subscribe">Subscribe</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") !== "true";
    toggle.setAttribute("aria-expanded", String(open));
    document.querySelector(".site-header")?.classList.toggle("open", open);
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }
  ul {
    display: flex;
    align-items: center;
    gap: 28px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  ul a:not(.btn) {
    color: var(--text-2);
    text-decoration: none;
    font-size: 15px;
    transition: color 150ms var(--ease);
  }
  ul a:not(.btn):hover,
  ul a[aria-current="page"] {
    color: var(--text);
  }
  .menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    place-items: center;
    background: transparent;
    border: 0;
    color: var(--text);
    cursor: pointer;
  }
  .menu-toggle :global(svg) {
    width: 22px;
    height: 22px;
  }
  .menu-toggle :global(.i-close) {
    display: none;
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  @media (max-width: 720px) {
    .menu-toggle {
      display: grid;
      margin-right: -10px;
    }
    ul {
      display: none;
      position: absolute;
      left: 0;
      right: 0;
      top: 64px;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 8px var(--gutter) 20px;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
    }
    .open ul {
      display: flex;
    }
    .open .menu-toggle :global(.i-open) {
      display: none;
    }
    .open .menu-toggle :global(.i-close) {
      display: block;
    }
    ul a:not(.btn) {
      display: block;
      padding: 12px 0;
      font-size: 17px;
    }
    .cta {
      margin-top: 12px;
    }
    .cta .btn {
      width: 100%;
      height: 44px;
    }
  }
</style>
