---
// The wordmark with a small ferry mark drawn in one color.
import { show } from "../data/show";
---

<a href="/" class="logo" aria-label={`${show.name}, home`}>
  <svg viewBox="0 0 32 20" aria-hidden="true">
    <path d="M3 11h26l-3.5 6h-19z" fill="currentColor"></path>
    <rect x="9" y="6" width="12" height="5" rx="1" fill="currentColor"></rect>
    <rect x="13" y="2" width="2.5" height="4" fill="currentColor"></rect>
    <rect x="11" y="7.5" width="2" height="2" fill="var(--lamp)"></rect>
    <rect x="15" y="7.5" width="2" height="2" fill="var(--lamp)"></rect>
  </svg>
  <span>{show.name}</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--text);
  }
  svg {
    width: 30px;
    height: 19px;
  }
</style>
