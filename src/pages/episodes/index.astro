---
import Base from "../../layouts/Base.astro";
import EpisodeRow from "../../components/EpisodeRow.astro";
import { show } from "../../data/show";
import { getEpisodes } from "../../lib/episodes";

const episodes = await getEpisodes();
const seasons = [...new Set(episodes.map((e) => e.data.season))].sort((a, b) => b - a);
---

<Base title="All episodes" description={`Every episode of ${show.name}, newest first, with show notes.`}>
  <section class="wrap page-head">
    <h1>All episodes</h1>
    <p class="lede">{episodes.length} conversations recorded on night shifts across the city, newest first.</p>
    <label class="search">
      <span class="sr">Search episodes</span>
      <input type="search" placeholder="Search" data-filter autocomplete="off" />
    </label>
  </section>

  {
    seasons.map((season) => (
      <section class="wrap season" data-season aria-labelledby={`season-${season}`}>
        <h2 id={`season-${season}`}>Season {season}</h2>
        <ul>
          {episodes
            .filter((e) => e.data.season === season)
            .map((episode) => (
              <EpisodeRow episode={episode} />
            ))}
        </ul>
      </section>
    ))
  }
  <p class="wrap empty" data-empty hidden>No episodes match that search.</p>
</Base>

<script>
  const input = document.querySelector<HTMLInputElement>("[data-filter]");
  input?.addEventListener("input", () => {
    const q = input.value.trim().toLowerCase();
    let shown = 0;
    document.querySelectorAll<HTMLElement>("[data-season]").forEach((section) => {
      let inSeason = 0;
      section.querySelectorAll<HTMLElement>("[data-search]").forEach((row) => {
        const match = !q || row.dataset.search!.includes(q);
        row.hidden = !match;
        if (match) inSeason++;
      });
      section.hidden = inSeason === 0;
      shown += inSeason;
    });
    document.querySelector<HTMLElement>("[data-empty]")!.hidden = shown > 0;
  });
</script>

<style>
  .page-head {
    padding-top: clamp(48px, 7vw, 88px);
    padding-bottom: 40px;
    display: grid;
    gap: 16px;
  }
  h1 {
    font-size: clamp(36px, 5vw, 56px);
    letter-spacing: -0.02em;
  }
  .search {
    margin-top: 16px;
    max-width: 360px;
  }
  .search input {
    width: 100%;
    height: 44px;
    padding: 0 14px;
    background: var(--deep);
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    color: var(--text);
    font: 400 16px var(--font);
  }
  .search input:focus {
    outline: none;
    border-color: var(--lamp);
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .season {
    padding-bottom: 48px;
  }
  .season h2 {
    font-size: 15px;
    font-weight: 400;
    color: var(--muted);
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .empty {
    padding-bottom: 80px;
    color: var(--text-2);
  }
</style>
