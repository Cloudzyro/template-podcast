---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Cover from "../../components/Cover.astro";
import Player from "../../components/Player.astro";
import Shift from "../../components/Shift.astro";
import Subscribe from "../../components/Subscribe.astro";
import { show } from "../../data/show";
import { getEpisodes, episodeUrl, formatDate, minutes, toSeconds, type Episode } from "../../lib/episodes";

export async function getStaticPaths() {
  const episodes = await getEpisodes();
  return episodes.map((episode, i) => ({
    params: { slug: episode.id },
    props: { episode, newer: episodes[i - 1], older: episodes[i + 1] },
  }));
}

interface Props {
  episode: Episode;
  newer?: Episode;
  older?: Episode;
}

const { episode, newer, older } = Astro.props;
const d = episode.data;
const { Content } = await render(episode);
const schema = {
  "@context": "https://schema.org",
  "@type": "PodcastEpisode",
  name: d.title,
  description: d.summary,
  datePublished: d.date.toISOString().slice(0, 10),
  episodeNumber: d.number,
  url: new URL(episodeUrl(episode), Astro.site).toString(),
  associatedMedia: { "@type": "MediaObject", contentUrl: new URL(d.audio.url, Astro.site).toString() },
  partOfSeries: { "@type": "PodcastSeries", name: show.name, url: Astro.site?.toString() },
};
---

<Base title={`${d.number}. ${d.title}`} description={d.summary} schema={schema}>
  <article>
    <header class="wrap ep-head">
      <div class="ep-text">
        <p class="crumbs mono">
          <a href="/episodes/">Episodes</a>
          <span aria-hidden="true">/</span>
          <span>Season {d.season}, episode {d.number}</span>
        </p>
        <h1>{d.title}</h1>
        <p class="lede">{d.summary}</p>
        <dl class="facts">
          <div><dt>Guest</dt><dd>{d.guest.name}, {d.guest.role.toLowerCase()}</dd></div>
          <div><dt>Where</dt><dd>{d.guest.place}</dd></div>
          <div><dt>Released</dt><dd>{formatDate(d.date)}</dd></div>
          <div><dt>Length</dt><dd>{minutes(d.duration)}</dd></div>
        </dl>
      </div>
      <div class="ep-art">
        <Cover scene={d.cover} number={d.number} label={`Cover art for ${d.title}: a night scene at ${d.guest.place}`} class="cover" />
        <div class="player-card">
          <Shift time={d.shift} long />
          <Player id={episode.id} title={d.title} src={d.audio.url} duration={d.duration} embedUrl={d.embedUrl} />
        </div>
      </div>
    </header>

    <div class="wrap body">
      <div class="notes">
        <h2 class="notes-title">Show notes</h2>
        <div class="prose">
          <Content />
        </div>
        {
          d.links.length > 0 && (
            <section class="links" aria-labelledby="links-title">
              <h2 id="links-title">Mentioned in this episode</h2>
              <ul>
                {d.links.map((link) => (
                  <li>
                    <a href={link.href}>{link.label}</a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </div>
      <aside class="side">
        {
          d.chapters.length > 0 && (
            <section aria-labelledby="chapters-title">
              <h2 id="chapters-title">Chapters</h2>
              <ol class="chapters">
                {d.chapters.map((c) => (
                  <li>
                    <button type="button" data-chapter={toSeconds(c.time)}>
                      <span class="mono">{c.time}</span>
                      <span>{c.title}</span>
                    </button>
                  </li>
                ))}
              </ol>
            </section>
          )
        }
        <section aria-labelledby="follow-title">
          <h2 id="follow-title">Follow the show</h2>
          <Subscribe />
        </section>
      </aside>
    </div>

    <nav class="wrap pager" aria-label="More episodes">
      {
        older ? (
          <a href={episodeUrl(older)} class="prev">
            <span class="mono">Previous episode</span>
            <span>{older.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        newer && (
          <a href={episodeUrl(newer)} class="next">
            <span class="mono">Next episode</span>
            <span>{newer.data.title}</span>
          </a>
        )
      }
    </nav>
  </article>
</Base>

<style>
  .ep-head {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: clamp(32px, 6vw, 80px);
    padding-top: clamp(40px, 6vw, 80px);
    padding-bottom: clamp(48px, 6vw, 80px);
    align-items: start;
  }
  .crumbs {
    display: flex;
    gap: 8px;
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 24px;
  }
  .crumbs a {
    color: var(--text-2);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--text);
  }
  h1 {
    font-size: clamp(40px, 5.6vw, 68px);
    letter-spacing: -0.03em;
    line-height: 1.02;
    margin-bottom: 24px;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px 32px;
    margin: 40px 0 0;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .facts dt {
    font-size: 13px;
    color: var(--muted);
  }
  .facts dd {
    margin: 4px 0 0;
  }
  .ep-art {
    display: grid;
    gap: 0;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 20px;
    overflow: hidden;
  }
  .ep-art :global(.cover) {
    width: 100%;
    aspect-ratio: 5 / 4;
  }
  .player-card {
    display: grid;
    gap: 16px;
    padding: 20px;
  }
  .body {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: clamp(32px, 6vw, 80px);
    padding-top: 56px;
    padding-bottom: 80px;
    border-top: 1px solid var(--line);
  }
  .notes-title,
  .side h2,
  .links h2 {
    font-size: 15px;
    font-weight: 400;
    color: var(--muted);
    margin-bottom: 20px;
  }
  .links {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .links ul {
    margin: 0;
    padding-left: 20px;
    color: var(--text-2);
    display: grid;
    gap: 8px;
  }
  .links a {
    color: var(--text);
    text-decoration-color: var(--lamp);
    text-underline-offset: 3px;
  }
  .side {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 48px;
    align-content: start;
  }
  .chapters {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .chapters li + li {
    border-top: 1px solid var(--line);
  }
  .chapters button {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 12px;
    width: 100%;
    padding: 12px 0;
    background: none;
    border: 0;
    color: var(--text);
    font: 400 15px/1.4 var(--font);
    text-align: left;
    cursor: pointer;
  }
  .chapters .mono {
    color: var(--lamp);
    font-size: 13px;
    padding-top: 1px;
  }
  .chapters button:hover span:last-child {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .side :global(.subscribe .btn) {
    height: 36px;
    padding: 0 14px;
    font-size: 14px;
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    padding-bottom: 96px;
  }
  .pager a {
    display: grid;
    gap: 4px;
    padding: 20px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 12px;
    text-decoration: none;
    font-size: 18px;
    transition: border-color 150ms var(--ease);
  }
  .pager a:hover {
    border-color: var(--line-strong);
  }
  .pager .mono {
    font-size: 13px;
    color: var(--muted);
  }
  .next {
    text-align: right;
  }
  @media (max-width: 900px) {
    .ep-head,
    .body {
      grid-template-columns: minmax(0, 1fr);
    }
    .ep-art {
      max-width: 520px;
    }
  }
  @media (max-width: 560px) {
    .pager {
      grid-template-columns: minmax(0, 1fr);
    }
    .next {
      text-align: left;
    }
  }
</style>
