---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found" description="This page isn't here.">
  <section class="wrap lost">
    <h1>Nothing on this frequency</h1>
    <p class="lede">The page you were looking for isn't here. The latest episode is, though.</p>
    <div class="actions">
      <a class="btn btn-primary" href="/">Go to the home page</a>
      <a class="btn btn-quiet" href="/episodes/">All episodes</a>
    </div>
  </section>
</Base>

<style>
  .lost {
    padding-top: clamp(80px, 14vw, 160px);
    padding-bottom: clamp(80px, 14vw, 160px);
    display: grid;
    gap: 20px;
    justify-items: start;
  }
  h1 {
    font-size: clamp(36px, 6vw, 64px);
    letter-spacing: -0.02em;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 12px;
  }
</style>
